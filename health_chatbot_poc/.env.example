# ---- LLM (OpenAI via langchain-openai) ----
OPENAI_API_KEY=sk-your-key-here
SMALL_MODEL=gpt-5.4-mini        # router, lookup/insight/coaching paths, validator, mem0
LARGE_MODEL=gpt-5.5             # deep-analysis (code-writing) path only
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# ---- Postgres (pgvector image; also used by mem0 + LangGraph checkpointer) ----
POSTGRES_HOST=localhost         # docker compose overrides this to "postgres" for the backend container
POSTGRES_PORT=5434
POSTGRES_HOST_PORT=5434         # host ports published by docker compose
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8501
POSTGRES_DB=health_poc
POSTGRES_USER=health
POSTGRES_PASSWORD=health

# ---- Frontend ----
BACKEND_URL=http://localhost:8000
APP_ADMIN_EMAIL=admin@gmail.com
APP_ADMIN_PASSWORD=admin

# ---- Optional: LangSmith tracing ----
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=health-chatbot-poc
